{
  "name": "ms-eeid-agent-toolkit",
  "version": "0.2.0",
  "private": true,
  "description": "Portable Microsoft Entra External ID skills for AI coding assistants.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AzureAD/ms-eeid-agent-toolkit.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "skill:create": "node scripts/create-skill.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:release": "node scripts/validate.mjs --release",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test": "node --test \"tests/tooling/*.test.mjs\" \"tests/skills/*.test.mjs\"",
    "test:install": "node tests/packaging/install-smoke.mjs",
    "eval:agent": "node scripts/evals/run.mjs"
  },
  "devDependencies": {
    "ajv": "8.18.0",
    "yaml": "2.8.3"
  }
}
